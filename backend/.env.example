# Bu dosyayı .env adıyla kopyalayıp değerleri doldurun. .env asla repoya girmez.

# SportsAPI Pro anahtarı (https://sportsapipro.com). Ücretsiz plan: günde 100 istek.
SPORTS_API_KEY=

# Postgres bağlantı adresi (canlıda Neon, "pooled" adres). Boş bırakılırsa yerelde
# backend/fenerbahce.db SQLite dosyası kullanılır.
# Not: Uygulama bu dosyadaki DATABASE_URL'yi kendisi okumaz (yerelde yanlışlıkla canlı
# veritabanına yazılmasın); sadece scripts/migrate_to_postgres.py okur. Yerel uygulamayı
# Postgres'e bağlamak için değişkeni kabukta açıkça verin.
DATABASE_URL=

# Gol bildirimi (Web Push). Üretmek için: python scripts/vapid_keys.py
# Boş bırakılırsa bildirim özelliği kapalı kalır, site normal çalışır.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# RENDER: Render'ın kendisi tanımlar, elle girilmez.
